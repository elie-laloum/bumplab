{
  "name": "@elie-laloum/bumplab",
  "version": "0.2.0",
  "description": "Migrate one npm dependency with bounded source edits and recorded checks",
  "type": "module",
  "license": "MIT",
  "author": "Elie Laloum",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "bumplab": "dist/bin/bumplab.js"
  },
  "exports": {
    "types": "./dist/src/engine.d.ts",
    "import": "./dist/src/engine.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.fr.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.ts",
    "demo": "node examples/demo.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm test",
    "prepack": "tsc -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.elielaloum.com/elielaloum/bumplab.git"
  },
  "types": "./dist/src/engine.d.ts",
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "^24.0.0",
    "prettier": "3.9.8"
  }
}
